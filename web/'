import { Link, useLocation } from 'react-router-dom';
import { ChevronDown } from 'lucide-react';
import { useState } from 'react';

type NavItem = {
	path: string;
	label: string;
	dropdownItems?: { path: string; label: string; }[];
};

const navItems: NavItem[] = [
	{
		path: '/economic-theory',
		label: 'Economic Theory',
		dropdownItems: [
			{ path: '/economic-theory/why-barter', label: 'The Case For Barter' },
		]
	},
	{
		path: '/barter-networks',
		label: 'Networks',
		dropdownItems: [
			{ path: '/barter-networks/cycles', label: 'Cycles' },
			{ path: '/barter-networks/analysis', label: 'Analysis' }
		]
	},
	{
		path: '/learning',
		label: 'Learning',
		dropdownItems: [
			{ path: '/learning/basics', label: 'Basics' },
			{ path: '/learning/sdp', label: 'SDP' },
			{ path: '/learning/maxcut', label: 'Max-Cut' },
			{ path: '/learning/gwa', label: 'GWA' }
		]
	}
];

const DropdownNavLink = ({ to, children }: { to: string; children: React.ReactNode }) => {
	const { pathname } = useLocation();
	const isActive = pathname === to;

	return (
		<Link
			to={to}
			className={`px-4 py-2 w-full text-left transition-colors duration-200 text-content-secondary hover:text-content-primary hover:bg-background-tertiary ${
				isActive ? 'bg-background-secondary text-quantum-bra' : ''
			}`}
		>
			{children}
		</Link>
	);
};

const NavDropdown = ({ item, isOpen, setIsOpen }: { 
	item: NavItem; 
	isOpen: string | null; 
	setIsOpen: (value: string | null) => void;
}) => {
	const { pathname } = useLocation();
	const identifier = item.path.split('/')[1];

	return (
		<div className="relative">
			<div className="flex items-center">
				<Link
					to={item.path}
					className={`px-4 py-2 rounded-l-lg font-medium transition-colors duration-200 text-content-secondary hover:text-content-primary ${
						pathname === item.path ? 'bg-background-secondary text-quantum-bra' : 'hover:bg-background-tertiary'
					}`}
				>
					{item.label}
				</Link>
				<button
					onClick={() => setIsOpen(isOpen === identifier ? null : identifier)}
					className={`px-2 py-2 rounded-r-lg border-l border-background-tertiary transition-colors duration-200 text-content-secondary hover:text-content-primary ${
						pathname.startsWith(item.path + '/') ? 'bg-background-secondary text-quantum-bra' : 'hover:bg-background-tertiary'
					}`}
				>
					<ChevronDown className={`w-4 h-4 transition-transform duration-200 ${isOpen === identifier ? 'rotate-180' : ''}`} />
				</button>
			</div>
			{isOpen === identifier && item.dropdownItems && (
				<div className="absolute top-full mt-1 right-0 w-48 py-2 bg-background-primary rounded-lg shadow-lg border border-background-tertiary flex flex-col">
					{item.dropdownItems.map(dropdownItem => (
						<DropdownNavLink key={dropdownItem.path} to={dropdownItem.path}>
							{dropdownItem.label}
						</DropdownNavLink>
					))}
				</div>
			)}
		</div>
	);
};

export const Nav = () => {
	const [isOpen, setIsOpen] = useState<string | null>(null);

	return (
		<nav className="sticky top-0 z-50 w-full bg-background-primary/80 backdrop-blur-sm border-b border-background-tertiary">
			<div className="container mx-auto px-4 py-3">
				<div className="flex items-center justify-between">
					<Link to="/" className="text-xl font-bold text-content-primary hover:text-quantum-bra transition-colors duration-200">
						Quantum Barter Networks
					</Link>
					<div className="flex gap-3 items-center">
						{navItems.map(item => (
							<NavDropdown 
								key={item.path} 
								item={item} 
								isOpen={isOpen} 
								setIsOpen={setIsOpen} 
							/>
						))}
					</div>
				</div>
			</div>
		</nav>
	);
};
